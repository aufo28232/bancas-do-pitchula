{
  "name": "bancas-do-pitchula",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "supabase test db",
    "deps:pin": "node scripts/pin-deps.mjs",
    "audit:deps": "pnpm audit --audit-level high",
    "seed:owner": "tsx scripts/seed-owner.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/realtime-js": "2.118.0",
    "next": "16.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postgres": "3.4.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@12.15.0"
}
