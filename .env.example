# =====================================================================
# Bancas do Pitchula: variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou configure no painel da hospedagem.
# NUNCA versione o arquivo com valores reais. Nada aqui é NEXT_PUBLIC_ por
# padrão: o servidor lê em tempo de execução (DECISIONS D-026).
# A coluna "Etapa" indica a partir de quando a variável é usada.
# =====================================================================

# --- Plataforma (Etapa 1) ---------------------------------------------
# Nome usado em todos os textos ("ID na 4fly", "CPF cadastrado na 4fly").
PLATFORM_NAME=4fly
# Link "Ainda não tem conta? Cadastre-se aqui". Vazio = o link some. Só https.
PLATFORM_SIGNUP_URL=https://go.aff.4fly.game/3kxqo488

# --- Deploy (Etapa 1) -------------------------------------------------
# managed | cloudflare_locked | tunnel. Decide se o CF-Connecting-IP é
# confiável. Ver README, "Modos de deploy".
DEPLOY_MODE=managed
# URL pública do site (metadados e checagem de Origin/CSRF).
SITE_URL=http://localhost:3000

# --- Supabase (Etapa 2) -----------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
# Chave pública (anon / publishable). Pode ir para o navegador (só Realtime).
SUPABASE_ANON_KEY=
# Chave de serviço (service role / secret). SOMENTE no servidor.
SUPABASE_SERVICE_ROLE_KEY=
# Segredo do Turnstile usado pelo captcha do Supabase Auth (config.toml).
# Chave de TESTE da Cloudflare (sempre aprova); troque em produção.
SUPABASE_AUTH_CAPTCHA_SECRET=1x0000000000000000000000000000000AA

# --- Have I Been Pwned (Etapa 2, opcional) -----------------------------
# Padrão: https://api.pwnedpasswords.com. Fora do ar = senha recusada (D-012).
HIBP_API_URL=https://api.pwnedpasswords.com

# --- Cloudflare Turnstile (Etapa 2) -----------------------------------
# Chaves de TESTE da Cloudflare (sempre aprovam). Troque em produção.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Upstash Redis (Etapa 2) ------------------------------------------
# Produção: URL e token REST do banco no Upstash. Desenvolvimento: um Redis local
# atrás do serverless-redis-http (veja README). Fora do ar = login/convite bloqueados.
UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
UPSTASH_REDIS_REST_TOKEN=token-local-de-teste

# --- HMAC (Etapa 2) ----------------------------------------------------
# Rate limit, dispositivos e (Etapa 3) anti-duplicidade. Gerar: openssl rand -base64 32
# Formato JSON {"versão":"chave base64"}; *_ACTIVE indica a versão de escrita (D-013).
HMAC_KEYS={"1":"COLOQUE_AQUI_32_BYTES_EM_BASE64"}
HMAC_ACTIVE=1

# --- Criptografia (Etapa 3) -------------------------------------------
# Chaves de cifra SEPARADAS das de HMAC. Mesmo formato.
DATA_ENC_KEYS={"1":"COLOQUE_AQUI_32_BYTES_EM_BASE64"}
DATA_ENC_ACTIVE=1

# --- Somente testes de integração (local/CI) ---------------------------
# Conexão direta ao Postgres local do Supabase (supabase status mostra o valor).
DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Cloudflare Access (Etapa 7, opcional) ----------------------------
# Se preenchidos, o servidor valida o JWT do Access em /painel.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- E-mail de alertas (opcional) -------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
